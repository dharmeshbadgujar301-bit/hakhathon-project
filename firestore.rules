rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }
    
    // Other collections (patients, doctors, appointments, etc.)
    // Allow read/write for all authenticated users to fix the "permission-denied" errors across Admin/Doctor/Receptionist panels.
    // In a production app, you would use get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' etc.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
